# .gitignore — generated by speckit init (ADR-0025), specialised for C++/CMake.
#
# Binary artifacts never enter the tree: everything a configure or a build
# produces is regenerated, and a committed artifact goes stale silently.

# --- OS junk ---------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Desktop.ini

# --- Editor / IDE ----------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
.cache/
.clangd/

# --- Build outputs ---------------------------------------------------------
# Any preset tree lives under build/ (P-08).
build/
cmake-build-*/
out/
install/
staging/
*.o
*.a
*.so
*.so.*
*.dylib
*.dll
*.exe
*.pdb
*.ilk
*.dSYM/

# --- CMake -----------------------------------------------------------------
CMakeCache.txt
CMakeFiles/
CMakeUserPresets.json
cmake_install.cmake
CTestTestfile.cmake
Testing/
_deps/
.ninja_deps
.ninja_log
build.ninja
rules.ninja

# --- Compilation database and tooling caches -------------------------------
compile_commands.json
compile_flags.txt
.ccache/
.sccache/
sccache/
*.gcda
*.gcno
*.gcov

# --- Sanitizer and profiler output ----------------------------------------
*.profraw
*.profdata
*.memreport
__sanitizer_report.*
perf.data*
callgrind.out.*
massif.out.*
*.heapprofile

# --- Fetched dependencies -------------------------------------------------
# mimalloc is fetched at configure time (P-14); the cache stays out of the tree.
.cache/antares/

# --- Logs ------------------------------------------------------------------
*.log
logs/

# --- Environment / secrets -------------------------------------------------
.env
.env.*
!.env.example

# --- speckit control plane (ADR-0028, ADR-0029) ----------------------------
# The born-local SQLite databases and their WAL/SHM sidecars are never
# committed: `speckit-local.db` (durable lock/audit) and `speckit-index.db`
# (the rebuildable derived cache). All speckit runtime/derived state lives
# under doc/.specify; the committed control plane is the text in doc/arch.
doc/.specify/speckit-*.db
doc/.specify/speckit-*.db-wal
doc/.specify/speckit-*.db-shm
