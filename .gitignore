# .gitignore — generated by speckit init (ADR-0025), specialised for C++/CMake.
#
# Binary artifacts never enter the tree: everything a configure or a build
# produces is regenerated, and a committed artifact goes stale silently.

# --- OS junk ---------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Desktop.ini

# --- Editor / IDE ----------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
.cache/
.clangd/

# --- Build outputs ---------------------------------------------------------
# Any preset tree lives under build/ (P-08).
build/
cmake-build-*/
out/
install/
staging/
*.o
*.a
*.so
*.so.*
*.dylib
*.dll
*.exe
*.pdb
*.ilk
*.dSYM/

# --- CMake -----------------------------------------------------------------
CMakeCache.txt
CMakeFiles/
CMakeUserPresets.json
cmake_install.cmake
CTestTestfile.cmake
Testing/
_deps/
.ninja_deps
.ninja_log
build.ninja
rules.ninja

# --- Compilation database and tooling caches -------------------------------
compile_commands.json
compile_flags.txt
.ccache/
.sccache/
sccache/
*.gcda
*.gcno
*.gcov

# --- Sanitizer and profiler output ----------------------------------------
*.profraw
*.profdata
*.memreport
__sanitizer_report.*
perf.data*
callgrind.out.*
massif.out.*
*.heapprofile

# --- Fetched dependencies -------------------------------------------------
# mimalloc is fetched at configure time (P-14); the cache stays out of the tree.
.cache/antares/

# --- Logs ------------------------------------------------------------------
*.log
logs/

# --- Environment / secrets -------------------------------------------------
.env
.env.*
!.env.example

# --- speckit control plane (ADR-0028, ADR-0029) ----------------------------
# Nothing under doc/.specify is source. It holds the born-local SQLite pair
# (`speckit-local.db`, `speckit-index.db`), their WAL/SHM sidecars and the
# reindex lock — all rebuilt from the corpus, which is the committed text under
# doc/arch. Ignore the directory whole so a new runtime file needs no rule.
doc/.specify/
